  m_Script: {fileID: 11500000, guid: b6ef59760a0256247b3365249ea4df31, type: 3}
  m_Name: 
  m_EditorClassIdentifier: Assembly-CSharp::ChasingLight.StoryController
  slides:
  - storyImage: {fileID: -3703745273442668693, guid: 805aa4697355ede4da602329ab9c97d9, type: 3}
    storyText: The Garden of Rainbow is a realm where fae witches live joyfully, brimming with laughter and boundless happiness. It is guarded by the power of the ten Dawnstones.
  - storyImage: {fileID: -7502059278155545800, guid: 72078b462cf85754aa6bd10c966fc190, type: 3}
    storyText: Just as everyone was lost in joyous song and dance, a dark force struck. They were The Fallen Soul, possessing the power to reflect the deepest darkness within every heart. Sowing fear and despair wherever they went, they ruthlessly scoured the land for the Dawnstones.
  - storyImage: {fileID: -4189420392135206678, guid: 8d48901c0b85ffb468cfc91d7f0635b0, type: 3}
    storyText: 'To temporarily shield her people from the onslaught, the Queen of the Rainbow Garden scattered the stones across the realm. Now, a grand quest has been laid forth: to retrieve the Dawnstones and return them to the sacred altar. And you are the chosen one.'
  - storyImage: {fileID: -5416722715650672080, guid: 38cfb81c82caed749a3a40376ebd51d7, type: 3}
    storyText: 'This is the ancient tome detailing how to awaken the power of the Dawnstones.

      The book reads: Return the divine stones to their rightful place. Beware of your own subconscious, for if you are unwary, you shall be forever consumed by it.'
  nextSceneName: 
  displayImage: {fileID: 373809430}
  displayCanvasGroup: {fileID: 373809432}
